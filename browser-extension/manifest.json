{
  "manifest_version": 3,
  "name": "Sit-Say_Par",
  "version": "1.0",
  "description": "Explainable Myanmar Phishing URL Risk Assessment",
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://sit-say-par.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sit-Say_Par"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sitsaypar@local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}